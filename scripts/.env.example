# OtterWatch Docker Compose Environment Variables
# Copy this file to .env and adjust values

# Container Registry
REGISTRY=localhost:5000
VERSION=latest

# Build tool (docker or podman)
BUILD_TOOL=docker

# PostgreSQL/TimescaleDB
POSTGRES_USER=otterwatch
POSTGRES_PASSWORD=otterwatch
POSTGRES_DB=otterwatch
DB_PORT=5432

# MQTT Broker API Keys (must match server API keys)
MQTT_API_KEYS=["your-secret-api-key-here"]
MQTT_PORT=1883
MQTT_API_PORT=8085
MQTT_METRICS_PORT=9090

# OtterWatch Server
API_KEYS=your-secret-api-key-here
SERVER_PORT=8080
PUBLIC_URL=http://localhost:8080

# Ollama URL for AI agent
OLLAMA_URL=http://host.docker.internal:11434

# Log levels (trace, debug, info, warn, error)
MQTT_LOG_LEVEL=info
SERVER_LOG_LEVEL=info
AI_LOG_LEVEL=info
