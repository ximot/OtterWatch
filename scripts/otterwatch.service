[Unit]
Description=OtterWatch System Monitoring Agent
After=network.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/etc/otterwatch
ExecStart=/usr/bin/otterwatch-wrapper.sh
Restart=always
RestartSec=10

# Environment for wrapper script
Environment=OTTERWATCH_BIN_DIR=/usr/bin
Environment=OTTERWATCH_CONFIG_DIR=/etc/otterwatch
Environment=OTTERWATCH_DATA_DIR=/var/lib/otterwatch
Environment=OTTERWATCH_LOG=/var/log/otterwatch-wrapper.log
Environment=OTTERWATCH_PORT=8080

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/otterwatch /var/log /usr/bin /etc/otterwatch
PrivateTmp=true

# Resource limits
MemoryMax=256M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
